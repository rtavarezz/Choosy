# Choosy Backend Configuration
# Copy this file to 'main.env' and fill in your API keys

# =============================================================================
# DATABASE (Required for production, SQLite used for development)
# =============================================================================
# For local development - leave empty to use SQLite
DATABASE_URL=

# For production with PostgreSQL/Supabase
# DATABASE_URL=postgresql://username:password@host:port/database
# SUPABASE_URL=your_supabase_url_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# API KEYS (Optional - Without these, app uses mock data)
# =============================================================================

# Eventbrite API (Recommended - Global Events)
# Get free key: https://www.eventbrite.com/platform/api-keys
# Free tier: 10,000 requests/day
EVENTBRITE_API_KEY=

# Unsplash API (Beautiful Event Images) 
# Get free key: https://unsplash.com/developers
# Free tier: 1,000 requests/hour
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Ticketmaster API (Optional - Music/Sports Events)
# Get key: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
TICKETMASTER_API_SECRET=

# Meetup API (Optional - Community Events)
# Get key: https://www.meetup.com/api/
MEETUP_API_KEY=

# =============================================================================
# SECURITY (Auto-generated if not provided)
# =============================================================================
JWT_SECRET_KEY=
ALGORITHM=HS256

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
DEBUG=false
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000